---
interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-text">
      {t('footer.made_with')}
      <span aria-hidden="true" style="color: var(--color-accent-light);">♥</span>
      {t('footer.and')}
      <i class="devicon-astro-plain footer-astro-icon" aria-label="Astro" title="Astro"></i>
      {t('footer.by')}
    </p>
    <a href="#" class="footer-top" aria-label="Back to top">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 12V4M8 4L4 8M8 4L12 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--th-border);
    padding-block: 1.75rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-text {
    font-size: 0.8125rem;
    color: var(--th-text-3);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .footer-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--th-border);
    background: var(--th-surface);
    color: var(--th-text-2);
    text-decoration: none;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .footer-top:hover {
    color: var(--th-text-1);
    border-color: var(--th-toggle-border-hover);
    background: var(--th-toggle-bg-hover);
    transform: translateY(-2px);
  }

  .footer-astro-icon {
    font-size: 1rem;
    vertical-align: middle;
    color: #FF5D01;
  }
</style>
